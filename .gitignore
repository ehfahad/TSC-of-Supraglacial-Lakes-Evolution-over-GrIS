# ---------------------------------------------------------------- large data
# Raw satellite archives are redistributed via Zenodo (see data/README.md),
# not through git. Fetch them with `python data/download_data.py`.
data/raw/*.nc
data/raw/*.zip
data/raw/all_lakes_*.geojson

# Intermediate products that any user can regenerate from the raw archives.
data/interim/

# Run outputs, all regenerated by the scripts. The two images used by the
# README are tracked in assets/ instead.
results/
figures/

